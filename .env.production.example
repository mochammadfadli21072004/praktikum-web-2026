# ============================================================
# Contoh konfigurasi SERVER PRODUCTION (Pertemuan 11)
# Salin ke .env di server, JANGAN di-commit dengan nilai rahasia asli.
# ============================================================
APP_NAME="Praktikum Laravel"
APP_ENV=production
APP_KEY=
# WAJIB false: true di production membocorkan stack trace, path server, dan query SQL ke publik
APP_DEBUG=false
APP_URL=https://contoh-domain-anda.test

LOG_CHANNEL=stack
# Di production cukup catat error serius saja
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
# Cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
BCRYPT_ROUNDS=12
